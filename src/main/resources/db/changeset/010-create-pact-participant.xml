<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.20.xsd">
    <changeSet id="010-create-pact-participant" author="dev">
        <createTable tableName="pact_participant">
            <column name="id" type="UUID" defaultValueComputed="gen_random_uuid()">
                <constraints primaryKey="true" primaryKeyName="pk_pact_participant" nullable="false"/>
            </column>
            <column name="pact_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>
            <column name="joined_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint constraintName="fk_pact_participant_pact"
                                 baseTableName="pact_participant" baseColumnNames="pact_id"
                                 referencedTableName="pact" referencedColumnNames="id"
                                 onDelete="CASCADE"/>
        <addForeignKeyConstraint constraintName="fk_pact_participant_user"
                                 baseTableName="pact_participant" baseColumnNames="user_id"
                                 referencedTableName="users" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <!-- Пользователь не может вступить в один пакт дважды -->
        <addUniqueConstraint constraintName="uq_pact_participant_pact_user"
                             tableName="pact_participant" columnNames="pact_id, user_id"/>

        <createIndex tableName="pact_participant" indexName="idx_pact_participant_user_id">
            <column name="user_id"/>
        </createIndex>
    </changeSet>
</databaseChangeLog>
